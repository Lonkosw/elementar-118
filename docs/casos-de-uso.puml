@startuml
' Mesmo diagrama de docs/casos-de-uso.png, em PlantUML
left to right direction
skinparam usecase { BackgroundColor #e6f4f1 }
actor Jogador

rectangle "ELEMENTAR 118 — jogo da tabela periódica" {
  usecase "UC01 Consultar instruções" as UC01
  usecase "UC02 Iniciar partida" as UC02
  usecase "UC03 Selecionar dificuldade" as UC03
  usecase "UC04 Jogar partida" as UC04
  usecase "UC05 Validar resposta" as UC05
  usecase "UC06 Atualizar placar" as UC06
  usecase "UC07 Pausar partida" as UC07
  usecase "UC08 Desistir da partida" as UC08
  usecase "UC09 Encerrar partida\n(vitória / derrota)" as UC09
  usecase "UC10 Consultar ranking" as UC10
  usecase "UC11 Consultar conquistas" as UC11
  usecase "UC12 Desbloquear conquista" as UC12
  usecase "UC13 Salvar resultado" as UC13
  usecase "UC14 Jogar novamente" as UC14
}

Jogador -- UC01
Jogador -- UC02
Jogador -- UC04
Jogador -- UC10
Jogador -- UC11

UC02 ..> UC03 : <<include>>
UC04 ..> UC05 : <<include>>
UC05 ..> UC06 : <<include>>
UC04 ..> UC09 : <<include>>
UC09 ..> UC13 : <<include>>
UC07 ..> UC04 : <<extend>>
UC08 ..> UC04 : <<extend>>
UC12 ..> UC05 : <<extend>>
UC14 ..> UC09 : <<extend>>
@enduml
